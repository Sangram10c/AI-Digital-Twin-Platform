# ========================================
# Backend Environment Variables
# ========================================

# Application
NODE_ENV=development
APP_NAME=AI Digital Twin
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=v1
TRUST_PROXY=false
BODY_LIMIT=1mb

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_digital_twin?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email repo
GITHUB_WEBHOOK_SECRET=dev-github-webhook-secret-change-me
GITHUB_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/settings/integrations/github
GITHUB_OAUTH_ERROR_REDIRECT=http://localhost:3000/settings/integrations/github
GITHUB_OAUTH_STATE_TTL_SECONDS=600
OAUTH_TOKEN_ENCRYPTION_KEY=dev-oauth-token-encryption-key-32b

# AI - OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o

# AI - Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AI - Google Gemini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# AI - Default / Hybrid pipeline
# free_only = Groq/OpenRouter:free/HF/Cloudflare/Gemini only (skips OpenAI+Anthropic)
AI_DEFAULT_PROVIDER=groq
AI_BILLING_MODE=free_only
AI_EXTRACTION_MODE=light
AI_PROVIDER_FALLBACK=true
DIGEST_BATCH_SIZE=10
PR_BATCH_SIZE=5
MAX_AI_RETRIES=3

# AI - Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# AI - OpenRouter (use :free models only in free_only mode)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# AI - Hugging Face
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# AI - Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# AI - Gemini (free tier)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# AI - Ollama
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embeddings (Phase 09 — pgvector pipeline)
# Providers: openai | gemini | voyage | nomic | groq | local | mock
# Local/CI (default):
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
# Production (recommended — matches vector(1536)):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=sk-...
# Alternatives (set both provider + matching model):
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3-lite
# Not for production: groq (often 404), nomic free quota, local/mock
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_RETRIES=3
EMBEDDING_CONCURRENCY=5
EMBEDDING_VERSION=1
ENABLE_INCREMENTAL_EMBEDDINGS=true
VOYAGE_API_KEY=
NOMIC_API_KEY=

# Hybrid Search (Phase 10 — retrieval only, no chat LLMs)
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50
SEARCH_TIMEOUT_MS=8000
SEARCH_PREVIEW_CHARS=280
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_EMBEDDING_CACHE_TTL_SECONDS=3600
SEARCH_HISTORY_LIMIT=50
SEARCH_WEIGHT_SEMANTIC=0.55
SEARCH_WEIGHT_KEYWORD=0.25
SEARCH_WEIGHT_QUALITY=0.1
SEARCH_WEIGHT_FRESHNESS=0.05
SEARCH_WEIGHT_REPOSITORY=0.05
SEARCH_RRF_K=60

# Knowledge — source code ingest (free-tier friendly)
# Prioritizes auth/jwt/identity paths; caps files to protect GitHub rate limits.
KNOWLEDGE_SOURCE_CODE_ENABLED=true
KNOWLEDGE_SOURCE_CODE_MAX_FILES=80
KNOWLEDGE_SOURCE_CODE_MAX_FILE_BYTES=204800
KNOWLEDGE_SOURCE_CODE_FETCH_GAP_MS=50
KNOWLEDGE_SOURCE_CODE_ALLOW_LOCAL=true
# Optional absolute monorepo root for local ingest when GitHub token lacks repo access:
# KNOWLEDGE_SOURCE_CODE_LOCAL_ROOT=C:/AI-Digital-Twin-Platform

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Queue
QUEUE_PREFIX=ai-twin

# WebSocket
WS_CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
PRISMA_LOG_QUERIES=false

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
